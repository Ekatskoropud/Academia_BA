   "source": [
    "def fix_emb(x):\n",
    "    if isinstance(x, str):\n",
    "        x = x.strip(\"[]\")\n",
    "        arr = np.array([float(a) for a in x.split()])\n",
    "        return arr\n",
    "    return np.array(x)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "15c0d99b",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"embedding\"] = df[\"embedding\"].apply(fix_emb)\n",
    "\n",
    "X = np.vstack(df[\"embedding\"].values)\n",
    "y = df[\"cluster_name\"]\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6660712d",
   "metadata": {},
   "source": [
    "# Train/test split"
