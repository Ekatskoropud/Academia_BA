    "def top_words(tags, n=15):\n",
    "    words = []\n",
    "    for t in tags:\n",
    "        t = re.sub(r\"[^a-zA-Z ]\", \" \", t.lower())\n",
    "        words.extend(t.split())\n",
    "    return Counter(words).most_common(n)\n"
   ]
  },
